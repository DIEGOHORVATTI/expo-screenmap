{
  "name": "expo-screenmap",
  "version": "0.1.0",
  "description": "Live map of every Expo Router screen: screenshots, navigation links and re-capture on save.",
  "license": "MIT",
  "author": "Diego Horvatti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DIEGOHORVATTI/expo-screenmap.git"
  },
  "keywords": [
    "expo",
    "expo-router",
    "react-native",
    "screenshots",
    "sitemap",
    "playwright"
  ],
  "type": "module",
  "bin": {
    "expo-screenmap": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/config.ts",
    "./expo": {
      "types": "./src/expo.d.cts",
      "default": "./src/expo.cjs"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "playwright-core": "^1.56.0"
  },
  "peerDependencies": {
    "expo": "*",
    "react-dom": "*",
    "react-native-web": "*",
    "@expo/metro-runtime": "*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-native-web": {
      "optional": true
    },
    "@expo/metro-runtime": {
      "optional": true
    }
  }
}
